# off: deterministic scanning only; external: send redacted findings to AI.
CODEAUDIT_AI_MODE=off

# Provider: openai, anthropic, or openai-compatible.
CODEAUDIT_AI_PROVIDER=
CODEAUDIT_AI_MODEL=

# Use one generic key. Never commit a real value.
CODEAUDIT_AI_API_KEY=

# Optional, mainly for an OpenAI-compatible provider.
CODEAUDIT_AI_BASE_URL=
